{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Termust",
	"version": "0.1.0",
	"identifier": "com.termust.desktop",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Termust",
				"width": 1024,
				"height": 720,
				"minWidth": 640,
				"minHeight": 420,
				"resizable": true,
				"fullscreen": false,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:",
			"devCsp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
